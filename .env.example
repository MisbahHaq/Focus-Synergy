# Firebase project configuration
# Firebase console -> Project settings -> Your apps -> SDK setup and configuration
# Copy this file to `.env` at the repo root and fill in your values.
# `.env` is git-ignored; `frontend/env.js` is generated from it and is also git-ignored.

FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=

# Optional: only needed for Cloudinary image uploads.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_UPLOAD_PRECET=

# Optional: enables Firebase Analytics. Leave blank to disable.
FIREBASE_MEASUREMENT_ID=